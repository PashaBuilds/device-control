{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "paths": { "@shared/*": ["./src/shared/*"] }
  },
  "include": [
    "src/renderer/src/**/*",
    "src/shared/**/*.ts",
    "src/preload/index.d.ts",
    "tools/simulator/model.ts",
    "tools/simulator/e36233a-model.ts",
    "tools/simulator/n5745a-model.ts"
  ]
}
