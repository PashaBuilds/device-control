{
  "name": "cihaz-kontrol",
  "version": "0.9.0",
  "description": "TCP/IP üzerinden laboratuvar cihazlarını kontrol eden masaüstü uygulaması",
  "main": "out/main/index.js",
  "author": "Mert Cukur",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx tools/simulator/cli.ts",
    "dist:win": "electron-vite build && electron-builder --win nsis --x64 && node tools/build-portable.mjs",
    "e2e": "tsx tools/e2e/smoke.ts",
    "sim:lynq": "tsx tools/simulator/smartlynq-cli.ts",
    "sim:e36233a": "tsx tools/simulator/e36233a-cli.ts",
    "sim:n5745a": "tsx tools/simulator/n5745a-cli.ts"
  },
  "devDependencies": {
    "@fontsource/chakra-petch": "^5.2.7",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/ibm-plex-sans-condensed": "^5.2.8",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "puppeteer-core": "^25.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "uplot": "^1.6.32",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  }
}
